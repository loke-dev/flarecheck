{
  "name": "shared-resource-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "env": {
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "app-production",
          "database_id": "shared-database-id"
        }
      ]
    },
    "staging": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "app-production",
          "database_id": "shared-database-id"
        }
      ]
    }
  }
}
